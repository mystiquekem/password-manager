direction: down

classes: {
  salt: { style: { fill: "#E8F5E9"; stroke: "#4CAF50" } }
  iv: { style: { fill: "#E3F2FD"; stroke: "#2196F3" } }
  mac: { style: { fill: "#FFF3E0"; stroke: "#FF9800" } }
  cipher: { style: { fill: "#FFEBEE"; stroke: "#F44336" } }
  label: { style: { stroke-dash: 3; font-size: 10 } }
}

HexMap: "Figure 5: Hex Dump Map (vault1.enc)" {
  style.fill: "#f8f9fa"
  
  # The "Memory" Rows
  Rows: {
    direction: down
    style.stroke: transparent
    
    R1: "00000000  7F 59 DD E5 05 F1 FD B0 38 D9 31 95 A4 80 2F 64" { class: salt }
    R2: "00000010  78 63 C1 D3 33 96 C6 95 EF 9F 98 ED 08 13 94 FB" { class: iv }
    R3: "00000020  19 02 C0 EE 58 9A 18 71 34 CB 26 13 1D 57 B1 7B" { class: mac }
    R4: "00000030  02 38 D9 0C C7 3A 2B 00 E5 7A 4F FF 20 62 46 3F" { class: mac }
    R5: "00000040  82 BC F1 91 0F 3D EE D0 28 97 95 B8 48 76 07 10" { class: cipher }
    R6: "00000050  B1 50 F3 F2 12 16 E7 10 2B 62 06 14 17 15 20 83" { class: cipher }
    R7: "00000060  52 3C BE 7D 5D 79 F6 C8 26 C0 CC 04 68 7C 7B 9D" { class: cipher }
    
    R1 -> R2 -> R3 -> R4 -> R5 -> R6 -> R7 { style.stroke: transparent }
  }

  # Legends / Annotations on the right
  Annotations: {
    direction: down
    style.stroke: transparent
    
    L1: "**Random Salt (16B)**\nAnti-Rainbow Table" { class: label }
    L2: "**Random IV (16B)**\nUniqueness for AES-CBC" { class: label }
    L3: "**HMAC-SHA256 Tag (32B)**\nIntegrity Authentication" { class: label }
    L4: "**Ciphertext**\nEncrypted Data (AES-128)" { class: label }
  }

  # Connect rows to labels
  Rows.R1 -> Annotations.L1
  Rows.R2 -> Annotations.L2
  Rows.R3 -> Annotations.L3
  Rows.R4 -> Annotations.L3
  Rows.R5 -> Annotations.L4
}
