direction: down

classes: {
  box: { style: { stroke-width: 2; border-radius: 5 } }
  diff: { style: { fill: "#FFF9C4"; stroke: "#FBC02D" } }
  label: { style: { stroke-dash: 3; font-size: 11 } }
}

Comparison: "Figure 5: Cryptographic Diffusion Analysis" {
  style.fill: "#f8f9fa"

  Intro: "Identical Input (Password & Plaintext) results in Different Output" {
    shape: text
  }

  V1: "Vault 1 (vault1.enc)" {
    class: box
    style.fill: "#E8F5E9"
    H1: "00000000  7F 59 DD E5 05 F1 FD B0 38 D9 31 95 A4 80 2F 64"
  }

  V2: "Vault 2 (vault2.enc)" {
    class: box
    style.fill: "#E3F2FD"
    H2: "00000000  BE 78 24 E4 E7 1A 28 2C 15 9A DA 55 AE BC C3 29"
  }

  Analysis: {
    direction: right
    style.stroke: transparent
    
    Point: "DIFFERENT BYTES" {
      class: diff
    }
  }

  V1.H1 -> Analysis.Point: "CSPRNG Salt 1"
  V2.H2 -> Analysis.Point: "CSPRNG Salt 2"
  
  Conclusion: "Conclusion: Even with identical input, the output is unique due to non-deterministic Salt & IV" {
    shape: text
    style.font-size: 12
  }
}
